          }
        },
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.id) pm.collectionVariables.set('productId', r.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tulsi Mala\",\n  \"slug\": \"tulsi-mala\",\n  \"category\": \"sacred\",\n  \"subcategory\": \"mala\",\n  \"description\": \"Sacred tulsi mala for daily prayer\",\n  \"price_inr\": 299,\n  \"price_usd\": 3.59,\n  \"images\": [\"https://picsum.photos/seed/tulsi/600/400\"],\n  \"inventory_retail\": 100,\n  \"inventory_wholesale\": 500,\n  \"status\": \"active\",\n  \"variants\": [\n    { \"name\": \"108 beads\", \"price_inr\": 299, \"inventory\": 100, \"sku\": \"TULSI-108\" },\n    { \"name\": \"54 beads\", \"price_inr\": 199, \"inventory\": 80, \"sku\": \"TULSI-54\" }\n  ],\n  \"b2b_pricing\": [\n    { \"min_qty\": 50, \"max_qty\": 200, \"discount_pct\": 10 },\n    { \"min_qty\": 201, \"discount_pct\": 20 }\n  ],\n  \"traceability\": {\n    \"village_of_origin\": \"Vrindavan\",\n    \"artisan_name\": \"Local Artisans\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "products"]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tulsi Mala (Updated)\",\n  \"price_inr\": 349,\n  \"description\": \"Premium tulsi mala — handcrafted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Update Inventory",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inventory_retail\": 250,\n  \"inventory_wholesale\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/products/{{productId}}/inventory",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "products", "{{productId}}", "inventory"]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Orders",
