            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/products?page=1&per_page=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "50" },
                { "key": "q", "value": "", "disabled": true },
                { "key": "category", "value": "sacred", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "products", "{{productId}}"]
