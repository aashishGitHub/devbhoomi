# ─────────────────────────────────────────────────────────────────────────────
# Devbhoomi Storefront — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data Mode ─────────────────────────────────────────────────────────────────
# Set to "true" for static Cloudflare Pages demo (uses local mock data).
# Remove or set to "false" for production (uses Go backend API).
NEXT_PUBLIC_USE_MOCK=true

# ── Backend API ───────────────────────────────────────────────────────────────
# Only needed when NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://devbhoomi.com

# ── Payment (UPI + WhatsApp — used in both mock and production) ───────────────
# Your UPI VPA (e.g. name@paytm / name@upi / name@okicici)
NEXT_PUBLIC_UPI_ID=devbhoomi@paytm

# WhatsApp number WITH country code, no + or spaces (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ── Razorpay (Phase 3 — leave empty for now) ──────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
